{
    "name": "r1kon/pipe-dream",
    "description": "Pipe-driven development for Laravel: business flows that read like a table of contents, with every step logged, timed and explainable.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "pipeline", "workflow", "rules", "audit-log"],
    "authors": [
        {
            "name": "Kevin Eaton",
            "email": "kevin@kevineaton.dev"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/container": "^9.19|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^9.19|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.19|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.19|^10.0|^11.0|^12.0|^13.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "R1kon\\PipeDream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "R1kon\\PipeDream\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": ["R1kon\\PipeDream\\PipeDreamServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
