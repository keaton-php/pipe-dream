{
    "name": "keaton-php/pipe-dream",
    "description": "Run a business process as named stages of small rule classes, with a receipt of what each rule decided and why.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "pipeline",
        "pipe",
        "workflow",
        "flow",
        "rules",
        "audit-log",
        "logging",
        "business-rules",
        "keaton-php"
    ],
    "homepage": "https://github.com/keaton-php/pipe-dream",
    "support": {
        "issues": "https://github.com/keaton-php/pipe-dream/issues",
        "source": "https://github.com/keaton-php/pipe-dream",
        "security": "https://github.com/keaton-php/pipe-dream/security/policy"
    },
    "authors": [
        {
            "name": "Kevin Eaton",
            "email": "kevin@kevineaton.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/container": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Keaton\\PipeDream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keaton\\PipeDream\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": ["Keaton\\PipeDream\\PipeDreamServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
